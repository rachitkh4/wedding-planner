# Postgres connection strings. Locally these can be identical; in production
# DATABASE_URL should be a pooled connection and DIRECT_URL a direct one.
DATABASE_URL="postgresql://user:password@localhost:5432/shubhvivah?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/shubhvivah?schema=public"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-string"
NEXTAUTH_URL="http://localhost:3000"

# Bootstrap couple account, created by `npm run db:seed`
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="pick-a-strong-password"
ADMIN_NAME="The Couple"

# Guest-app notifications (optional until you want phone reminders).
# Generate the two keys once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="replace-with-the-public-key"
VAPID_PRIVATE_KEY="replace-with-the-private-key"
# Optional. A contact URL sent to browser push services; defaults to NEXTAUTH_URL.
# VAPID_SUBJECT="https://your-site.example.com"
# Any long random string; the 5-minute scheduler must send it (see README).
CRON_SECRET="replace-with-a-random-string"

