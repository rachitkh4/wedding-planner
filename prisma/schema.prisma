// Shubh Vivah — wedding planner data model

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Visibility {
  PRIVATE
  SELECTED
  EVERYONE
}

enum Role {
  COUPLE
  FAMILY
}

enum Side {
  BRIDE
  GROOM
  BOTH
}

enum RsvpStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum PaymentMethod {
  UPI
  CARD
  CASH
  BANK_TRANSFER
  CHEQUE
}

enum TravelDirection {
  ARRIVAL
  DEPARTURE
}

enum TravelMode {
  TRAIN
  FLIGHT
  BUS
  CAR
  OTHER
}

enum AnnouncementKind {
  ANNOUNCEMENT
  REMINDER
  SURPRISE
}

enum VendorStatus {
  RESEARCHING
  CONTACTED
  BOOKED
  PAID
  COMPLETED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  role         Role     @default(FAMILY)
  createdAt    DateTime @default(now())

  invitesCreated  InviteToken[]
  notes           Note[]

  ownedTasks    ChecklistTask[] @relation("ChecklistTaskOwner")
  ownedExpenses Expense[]       @relation("ExpenseOwner")
  ownedGuests   Guest[]         @relation("GuestOwner")
  ownedVendors  Vendor[]        @relation("VendorOwner")
  ownedShopping ShoppingItem[]  @relation("ShoppingItemOwner")

  sharedTasks    ChecklistTask[] @relation("ChecklistTaskSharedWith")
  sharedExpenses Expense[]       @relation("ExpenseSharedWith")
  sharedGuests   Guest[]         @relation("GuestSharedWith")
  sharedVendors  Vendor[]        @relation("VendorSharedWith")
  sharedShopping ShoppingItem[]  @relation("ShoppingItemSharedWith")
}

model InviteToken {
  id          String    @id @default(cuid())
  token       String    @unique @default(cuid())
  email       String?
  role        Role      @default(FAMILY)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
}

// Singleton row — always queried via findFirst(), never by a known id.
model WeddingMeta {
  id            String   @id @default(cuid())
  partner1Name  String
  partner2Name  String
  weddingDate   DateTime @db.Date
  city          String?
  autoReminders Boolean  @default(true) // automatic "starts in 1 hour" style event reminders
  updatedAt     DateTime @updatedAt
}

model EventItem {
  id        String   @id @default(cuid())
  name      String
  date      DateTime @db.Date
  venue     String?
  sortOrder Int      @default(0)

  // Guest-app fields
  startTime    String? // "HH:MM", 24-hour, India time
  nameHi       String?
  dressCode    String?
  mapUrl       String?
  description  String?
  showToGuests Boolean @default(true)

  scheduleEntries ScheduleEntry[]
  invitedGuests   Guest[]         @relation("GuestInvitedEvents")
}

model ScheduleEntry {
  id        String @id @default(cuid())
  eventId   String
  event     EventItem @relation(fields: [eventId], references: [id], onDelete: Cascade)
  time      String
  activity  String
  sortOrder Int    @default(0)
}

model ChecklistPhase {
  id        String @id @default(cuid())
  name      String
  sortOrder Int    @default(0)

  tasks ChecklistTask[]
}

model ChecklistTask {
  id         String   @id @default(cuid())
  phaseId    String
  phase      ChecklistPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  text       String
  done       Boolean  @default(false)
  assignedTo String?
  sortOrder  Int      @default(0)

  ownerId    String
  owner      User       @relation("ChecklistTaskOwner", fields: [ownerId], references: [id])
  visibility Visibility @default(EVERYONE)
  sharedWith User[]     @relation("ChecklistTaskSharedWith")
}

model BudgetCategory {
  id              String  @id @default(cuid())
  name            String
  estimatedAmount Decimal @db.Decimal(12, 2)
  sortOrder       Int     @default(0)

  expenses Expense[]
}

model Expense {
  id            String        @id @default(cuid())
  categoryId    String
  category      BudgetCategory @relation(fields: [categoryId], references: [id])
  date          DateTime      @db.Date
  description   String
  amount        Decimal       @db.Decimal(12, 2)
  paidBy        String
  paymentMethod PaymentMethod

  ownerId    String
  owner      User       @relation("ExpenseOwner", fields: [ownerId], references: [id])
  visibility Visibility @default(EVERYONE)
  sharedWith User[]     @relation("ExpenseSharedWith")

  createdAt DateTime @default(now())
}

model Guest {
  id          String     @id @default(cuid())
  name        String
  side        Side
  headcount   Int        @default(1)
  rsvpStatus  RsvpStatus @default(PENDING)
  phone       String?    @unique // E.164, e.g. +919876543210

  invitedEvents EventItem[] @relation("GuestInvitedEvents")

  ownerId    String
  owner      User       @relation("GuestOwner", fields: [ownerId], references: [id])
  visibility Visibility @default(EVERYONE)
  sharedWith User[]     @relation("GuestSharedWith")

  accounts GuestAccount[]
}

// A guest's login for the guest app (/g). Entirely separate from planner `User`s.
model GuestAccount {
  id             String    @id @default(cuid())
  name           String
  phone          String    @unique // E.164
  pinHash        String
  guestId        String?
  guest          Guest?    @relation(fields: [guestId], references: [id], onDelete: SetNull)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  sessionVersion Int       @default(0) // bumped on PIN reset to sign out old devices
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())

  locale         String    @default("en") // "en" | "hi": language for notifications
  updatesSeenAt  DateTime? // for the unread badge on the Updates bell

  pushSubscriptions PushSubscription[]

  // RSVP: attending is null until the guest answers. partySize includes the guest.
  attending Boolean?
  partySize Int?
  rsvpAt    DateTime?

  // Room, assigned by the couple and shown to the guest.
  stayPlace String?
  stayRoom  String?
  stayNote  String?

  members GuestMember[]
  travel  TravelLeg[]
}

// The other people coming with a GuestAccount (the account holder is not listed).
model GuestMember {
  id        String       @id @default(cuid())
  accountId String
  account   GuestAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int          @default(0)
}

// One arrival and one departure per account. dateTime is an absolute instant;
// guests enter it in India time.
model TravelLeg {
  id        String              @id @default(cuid())
  accountId String
  account   GuestAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  direction TravelDirection
  mode      TravelMode
  dateTime  DateTime
  place     String? // station / airport / city they travel from or to
  number    String? // train or flight number
  pnr       String?
  paxCount  Int                 @default(1)
  note      String?
  updatedAt DateTime            @updatedAt

  @@unique([accountId, direction])
}

model HelpContact {
  id        String @id @default(cuid())
  label     String
  name      String
  phone     String
  sortOrder Int    @default(0)
}

model Vendor {
  id           String       @id @default(cuid())
  category     String
  name         String
  contact      String?
  quotedCost   Decimal?     @db.Decimal(12, 2)
  advancePaid  Decimal      @default(0) @db.Decimal(12, 2)
  status       VendorStatus @default(RESEARCHING)

  ownerId    String
  owner      User       @relation("VendorOwner", fields: [ownerId], references: [id])
  visibility Visibility @default(EVERYONE)
  sharedWith User[]     @relation("VendorSharedWith")
}

model ShoppingItem {
  id             String  @id @default(cuid())
  item           String
  category       String?
  budgetEstimate Decimal? @db.Decimal(12, 2)
  bought         Boolean  @default(false)

  ownerId    String
  owner      User       @relation("ShoppingItemOwner", fields: [ownerId], references: [id])
  visibility Visibility @default(EVERYONE)
  sharedWith User[]     @relation("ShoppingItemSharedWith")
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// A guest's phone/browser that agreed to receive notifications.
model PushSubscription {
  id        String       @id @default(cuid())
  accountId String
  account   GuestAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  endpoint  String       @unique
  p256dh    String
  auth      String
  createdAt DateTime     @default(now())
}

// Something sent to every guest (push + shown in the app's Updates list). It is
// "sent" once sentAt is set; the first process to set it owns the send, so
// nothing goes out twice.
model Announcement {
  id          String             @id @default(cuid())
  kind        AnnouncementKind   @default(ANNOUNCEMENT)
  title       String
  titleHi     String?
  body        String
  bodyHi      String?
  sendAt      DateTime
  sentAt      DateTime?
  sentCount   Int                @default(0)
  failedCount Int                @default(0)
  eventId     String? // set for automatic event reminders
  reminderKey String?            @unique // makes reminder creation idempotent
  createdAt   DateTime           @default(now())

  @@index([sentAt, sendAt])
}

// Lets the Announcements page show whether the external scheduler is running.
model JobHeartbeat {
  name      String   @id
  lastRunAt DateTime
}
